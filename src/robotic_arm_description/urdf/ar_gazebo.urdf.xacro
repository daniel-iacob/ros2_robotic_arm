<?xml version="1.0"?>
<!-- Gazebo simulation entry point for the AR4 arm using gz_ros2_control.
     Mirrors fake_ar.urdf.xacro but uses the Gazebo plugin for real physics. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ar4_gazebo">
  <xacro:arg name="ar_model"   default="mk5" />
  <xacro:arg name="tf_prefix"  default="" />
  <xacro:arg name="include_gripper" default="true" />

  <!-- Robot geometry macros -->
  <xacro:include filename="$(find robotic_arm_description)/urdf/ar_macro.xacro" />
  <xacro:include filename="$(find robotic_arm_description)/urdf/ar_gripper_macro.xacro" />

  <!-- ros2_control macro (Gazebo variant — single block for arm + gripper) -->
  <xacro:include filename="$(find robotic_arm_description)/urdf/ar_gazebo.ros2_control.xacro" />

  <!-- World root -->
  <link name="world" />

  <!-- Arm links + joints -->
  <xacro:ar_robot
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    robot_parameters_file="$(find robotic_arm_description)/config/$(arg ar_model).yaml"
  >
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:ar_robot>

  <!-- Gripper links + joints -->
  <xacro:if value="$(arg include_gripper)">
    <xacro:ar_gripper
      tf_prefix="$(arg tf_prefix)"
      parent="$(arg tf_prefix)ee_link"
    />
  </xacro:if>

  <!-- Single ros2_control block for arm + gripper (gz_ros2_control requires it) -->
  <xacro:ar_gazebo_ros2_control
    ar_model="$(arg ar_model)"
    robot_parameters_file="$(find robotic_arm_description)/config/$(arg ar_model).yaml"
    tf_prefix="$(arg tf_prefix)"
    include_gripper="$(arg include_gripper)"
  />

  <!-- Gazebo plugin: loads gz_ros2_control with controller config -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find robotic_arm_moveit_config)/config/ros2_controllers_sim.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
